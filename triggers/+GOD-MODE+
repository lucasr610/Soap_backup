  echo " - Use paid APIs or make cloud calls unless --force is passed"
  echo " - Leave out license / author metadata"
  echo " - Omit status tracking in agent task progression"
  echo ""
  echo "✅ DO IT THIS WAY:"
  echo " - Use logging to ~/Soap/logs/"
  echo " - Tag every file with:"
  echo "     Author: Lucas Reynolds"
  echo "     License: MIT"
  echo "     Generated by: Codex God Mode ∞ — ARCH Version"
  echo " - Validate EOF integrity after writing agents"
  echo " - Use def run_<phase>(task: dict) → dict in agents"
  echo " - Update punchlist.md after every action"
  echo " - Never bypass controller logic or punchlist enforcement"
  echo ""
}

enforce(){
  local missing=0
  local required=("agents" "punchlist.md" "run_all_phases.py" "codex_controller.py" "requirements.txt")
  for item in "${required[@]}"; do
    if [ ! -e "$ROOT/$item" ]; then
      echo "❌ Missing: $item"
      log "Missing $item"
      missing=1
    fi
  done

  for phase in watson father mother arbiter soap; do
    local file="$ROOT/agents/${phase}_phase.py"
    if [ ! -f "$file" ]; then
      echo "❌ Missing agent: $file"
      log "Missing agent $file"
      missing=1
      continue
    fi
    if ! grep -q "def run_${phase}" "$file"; then
      echo "❌ Function run_${phase} not found in $file"
      log "run_${phase} missing in $file"
      missing=1
    fi
    for pattern in "Author: Lucas Reynolds" "License: MIT" "Generated by: Codex God Mode"; do
      if ! grep -q "$pattern" "$file"; then
        echo "❌ Metadata missing: $pattern in $file"
        log "Metadata $pattern missing in $file"
        missing=1
      fi
    done
    if ! tail -n 1 "$file" | grep -Eq "^(\s*)$"; then
      echo "❌ Possible cut-off: $file missing EOF newline or closing block"
      log "EOF missing in $file"
      missing=1
    fi
  done

  return $missing
}

repair(){
  mkdir -p "$ROOT/agents"
  local created=0

  for phase in watson father mother arbiter soap; do
    local file="$ROOT/agents/${phase}_phase.py"
    if [ ! -f "$file" ]; then
      cat > "$file" <<EOF
#!/usr/bin/env python3
"""
Author: Lucas Reynolds <lucasreynolds1988@gmail.com>
License: MIT
Generated by: Codex God Mode ∞ — ARCH Version
"""

def run_${phase}(task: dict) -> dict:
    # TODO: Implement ${phase} phase logic
    return task
EOF
      log "Created $file"
      created=1
    fi
  done

  if [ ! -f "$ROOT/punchlist.md" ]; then
    cat > "$ROOT/punchlist.md" <<'EOF'
## Punch List – Codex System

- [ ] Setup .venv and install requirements.txt
- [ ] Create watson_phase.py with run_watson()
- [ ] Wire agents into codex_controller.py
- [ ] Add spin_down.py and spin_up.py
- [ ] Generate snapshot after task completion
- [ ] Create restore_now.py
- [ ] Log all trigger activity
- [ ] Validate SOP status flows correctly
- [ ] Run trigger_test_harness.py to verify all agents
EOF
    log "Created punchlist.md"
    created=1
  fi

  if [ "$created" -eq 1 ]; then
    echo "✅ GOD MODE bootstrap complete."
  else
    echo "ℹ️  No changes made. System already satisfies baseline."
  fi
}

case "$1" in
  --enforce)
    enforce
    ;;
  --repair)
    repair
    ;;
  *)
    show_doc
    ;;
esac
