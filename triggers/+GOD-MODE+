ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOAP_DIR="${SOAP_ROOT:-$HOME/Soap}"
LOG_FILE="$SOAP_DIR/logs/god_mode.log"
mkdir -p "$(dirname "$LOG_FILE")"

log(){
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

show_doc(){
  cat "$ROOT/GOD_MODE_ARCH.md"
  log "Displayed GOD_MODE_ARCH.md"

  echo ""
  echo "────────────────────────────────────────────────────────────"
  echo "📎 CODING STANDARDS ENFORCED BY GOD MODE:"
  echo "────────────────────────────────────────────────────────────"
  echo "❌ DO NOT DO THIS:"
  echo " - Use print() — always use logging"
  echo " - Hardcode paths — use get_soap_root()"
  echo " - Leave TODOs or stubs — complete the logic"
